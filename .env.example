# Local evaluation settings. Use synthetic data only.
# These credentials initialize a NEW database; editing them does not rotate
# credentials stored in an existing MySQL volume.
MYSQL_ROOT_PASSWORD=local-evaluation-root-change-me
MYSQL_DATABASE=careloom
MYSQL_USER=careloom
MYSQL_PASSWORD=local-evaluation-user-change-me
# JJWT expects a Base64-encoded signing key. This public example is NOT secret.
JWT_SECRET_KEY=Y2FyZWxvb20tZXZhbHVhdGlvbi1vbmx5LWRvLW5vdC11c2Utd2l0aC1yZWFsLWRhdGEtY2FyZWxvb20tZXZhbHVhdGlvbi1vbmx5LWRvLW5vdC11c2Utd2l0aC1yZWFsLWRhdGEt

# Bound to loopback by docker-compose.full.yml. Choose unused ports.
ADMIN_PORT=3000
API_PORT=8080
# Database-only native developer setup uses this loopback port.
DB_PORT=3306

# Media uploads and maps require your own separately configured services.
# No AWS credentials or account-specific bucket are supplied by the project.
AWS_REGION=us-east-1
AWS_S3_BUCKET=careloom-media-not-configured
GOOGLE_MAP_API_KEY=not-configured

# Explicit first-install opt-in only. Disable after creating the new account.
# Existing accounts are NEVER reset; a username collision stops bootstrap.
CARELOOM_BOOTSTRAP_ADMIN_ENABLED=false
CARELOOM_BOOTSTRAP_ADMIN_USERNAME=evaluation_admin
CARELOOM_BOOTSTRAP_ADMIN_PASSWORD=evaluation-only-change-before-real-use
